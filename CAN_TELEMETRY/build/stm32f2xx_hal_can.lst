2030:Drivers/STM32F2xx_HAL_Driver/Src/stm32f2xx_hal_can.c ****             /* Set CAN error code to Bit recessive error */
2031:Drivers/STM32F2xx_HAL_Driver/Src/stm32f2xx_hal_can.c ****             errorcode |= HAL_CAN_ERROR_BR;
2032:Drivers/STM32F2xx_HAL_Driver/Src/stm32f2xx_hal_can.c ****             break;
2033:Drivers/STM32F2xx_HAL_Driver/Src/stm32f2xx_hal_can.c ****           case (CAN_ESR_LEC_2 | CAN_ESR_LEC_0):
2034:Drivers/STM32F2xx_HAL_Driver/Src/stm32f2xx_hal_can.c ****             /* Set CAN error code to Bit Dominant error */
2035:Drivers/STM32F2xx_HAL_Driver/Src/stm32f2xx_hal_can.c ****             errorcode |= HAL_CAN_ERROR_BD;
2036:Drivers/STM32F2xx_HAL_Driver/Src/stm32f2xx_hal_can.c ****             break;
2037:Drivers/STM32F2xx_HAL_Driver/Src/stm32f2xx_hal_can.c ****           case (CAN_ESR_LEC_2 | CAN_ESR_LEC_1):
2038:Drivers/STM32F2xx_HAL_Driver/Src/stm32f2xx_hal_can.c ****             /* Set CAN error code to CRC error */
2039:Drivers/STM32F2xx_HAL_Driver/Src/stm32f2xx_hal_can.c ****             errorcode |= HAL_CAN_ERROR_CRC;
2040:Drivers/STM32F2xx_HAL_Driver/Src/stm32f2xx_hal_can.c ****             break;
2041:Drivers/STM32F2xx_HAL_Driver/Src/stm32f2xx_hal_can.c ****           default:
2042:Drivers/STM32F2xx_HAL_Driver/Src/stm32f2xx_hal_can.c ****             break;
2043:Drivers/STM32F2xx_HAL_Driver/Src/stm32f2xx_hal_can.c ****         }
