1808:Drivers/STM32F2xx_HAL_Driver/Src/stm32f2xx_hal_uart.c **** /**
1809:Drivers/STM32F2xx_HAL_Driver/Src/stm32f2xx_hal_uart.c ****   * @brief Provide Rx Event type that has lead to RxEvent callback execution.
1810:Drivers/STM32F2xx_HAL_Driver/Src/stm32f2xx_hal_uart.c ****   * @note  When HAL_UARTEx_ReceiveToIdle_IT() or HAL_UARTEx_ReceiveToIdle_DMA() API are called, pro
1811:Drivers/STM32F2xx_HAL_Driver/Src/stm32f2xx_hal_uart.c ****   *        of reception process is provided to application through calls of Rx Event callback (eith
1812:Drivers/STM32F2xx_HAL_Driver/Src/stm32f2xx_hal_uart.c ****   *        HAL_UARTEx_RxEventCallback() or user registered one). As several types of events could o
1813:Drivers/STM32F2xx_HAL_Driver/Src/stm32f2xx_hal_uart.c ****   *        Half Transfer, or Transfer Complete), this function allows to retrieve the Rx Event type
1814:Drivers/STM32F2xx_HAL_Driver/Src/stm32f2xx_hal_uart.c ****   *        to Rx Event callback execution.
1815:Drivers/STM32F2xx_HAL_Driver/Src/stm32f2xx_hal_uart.c ****   * @note  This function is expected to be called within the user implementation of Rx Event Callba
1816:Drivers/STM32F2xx_HAL_Driver/Src/stm32f2xx_hal_uart.c ****   *        in order to provide the accurate value :
1817:Drivers/STM32F2xx_HAL_Driver/Src/stm32f2xx_hal_uart.c ****   *        In Interrupt Mode :
1818:Drivers/STM32F2xx_HAL_Driver/Src/stm32f2xx_hal_uart.c ****   *           - HAL_UART_RXEVENT_TC : when Reception has been completed (expected nb of data has be
1819:Drivers/STM32F2xx_HAL_Driver/Src/stm32f2xx_hal_uart.c ****   *           - HAL_UART_RXEVENT_IDLE : when Idle event occurred prior reception has been completed
1820:Drivers/STM32F2xx_HAL_Driver/Src/stm32f2xx_hal_uart.c ****   *             received data is lower than expected one)
1821:Drivers/STM32F2xx_HAL_Driver/Src/stm32f2xx_hal_uart.c ****   *        In DMA Mode :
1822:Drivers/STM32F2xx_HAL_Driver/Src/stm32f2xx_hal_uart.c ****   *           - HAL_UART_RXEVENT_TC : when Reception has been completed (expected nb of data has be
1823:Drivers/STM32F2xx_HAL_Driver/Src/stm32f2xx_hal_uart.c ****   *           - HAL_UART_RXEVENT_HT : when half of expected nb of data has been received
1824:Drivers/STM32F2xx_HAL_Driver/Src/stm32f2xx_hal_uart.c ****   *           - HAL_UART_RXEVENT_IDLE : when Idle event occurred prior reception has been completed
1825:Drivers/STM32F2xx_HAL_Driver/Src/stm32f2xx_hal_uart.c ****   *             received data is lower than expected one).
1826:Drivers/STM32F2xx_HAL_Driver/Src/stm32f2xx_hal_uart.c ****   *        In DMA mode, RxEvent callback could be called several times;
1827:Drivers/STM32F2xx_HAL_Driver/Src/stm32f2xx_hal_uart.c ****   *        When DMA is configured in Normal Mode, HT event does not stop Reception process;
1828:Drivers/STM32F2xx_HAL_Driver/Src/stm32f2xx_hal_uart.c ****   *        When DMA is configured in Circular Mode, HT, TC or IDLE events don't stop Reception proc
1829:Drivers/STM32F2xx_HAL_Driver/Src/stm32f2xx_hal_uart.c ****   * @param  huart UART handle.
1830:Drivers/STM32F2xx_HAL_Driver/Src/stm32f2xx_hal_uart.c ****   * @retval Rx Event Type (returned value will be a value of @ref UART_RxEvent_Type_Values)
1831:Drivers/STM32F2xx_HAL_Driver/Src/stm32f2xx_hal_uart.c ****   */
1832:Drivers/STM32F2xx_HAL_Driver/Src/stm32f2xx_hal_uart.c **** HAL_UART_RxEventTypeTypeDef HAL_UARTEx_GetRxEventType(UART_HandleTypeDef *huart)
1833:Drivers/STM32F2xx_HAL_Driver/Src/stm32f2xx_hal_uart.c **** {
1834:Drivers/STM32F2xx_HAL_Driver/Src/stm32f2xx_hal_uart.c ****   /* Return Rx Event type value, as stored in UART handle */
1835:Drivers/STM32F2xx_HAL_Driver/Src/stm32f2xx_hal_uart.c ****   return(huart->RxEventType);
1836:Drivers/STM32F2xx_HAL_Driver/Src/stm32f2xx_hal_uart.c **** }
1837:Drivers/STM32F2xx_HAL_Driver/Src/stm32f2xx_hal_uart.c **** 
1838:Drivers/STM32F2xx_HAL_Driver/Src/stm32f2xx_hal_uart.c **** /**
