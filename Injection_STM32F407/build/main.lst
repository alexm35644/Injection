 922:Core/Src/main.c ****     else if (strncmp(str, "sequence", 8) == 0)
 923:Core/Src/main.c ****     {
 924:Core/Src/main.c ****         printf("inject sequence...\r\n");
 925:Core/Src/main.c ****         injectSequence(); 
 926:Core/Src/main.c ****         
 927:Core/Src/main.c ****     }
 928:Core/Src/main.c ****     else if (strncmp(str, "foot on", 9) == 0)
 929:Core/Src/main.c ****     {
 930:Core/Src/main.c ****         printf("Foot Pedal Mode on!\r\n");
 931:Core/Src/main.c ****         footPedalMode = 1;
 932:Core/Src/main.c ****         
 933:Core/Src/main.c ****     }
 934:Core/Src/main.c ****     else if (strncmp(str, "foot off", 9) == 0)
 935:Core/Src/main.c ****     {
 936:Core/Src/main.c ****         printf("Foot Pedal Mode off!\r\n");
 937:Core/Src/main.c ****         footPedalMode = 0;
 938:Core/Src/main.c ****     }
 939:Core/Src/main.c **** 
 940:Core/Src/main.c ****     // Echoes string if no keywords are sent
 941:Core/Src/main.c ****     else
 942:Core/Src/main.c ****     {
 943:Core/Src/main.c ****         printf("Received: %s\r\n", str);
 944:Core/Src/main.c ****     }
