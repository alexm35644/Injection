 946:Core/Src/main.c **** void HomeSetUser() {
 947:Core/Src/main.c ****   static uint32_t lastMillis = 0;
 948:Core/Src/main.c ****   static uint8_t step = 0;  // To track which part of the process we are at.
 949:Core/Src/main.c **** 
 950:Core/Src/main.c ****   if (step == 0) {
 951:Core/Src/main.c ****       // Set Joint 1
 952:Core/Src/main.c ****       joint1 = JOINT1_HOME;
 953:Core/Src/main.c ****       Joint1Set(joint1);
 954:Core/Src/main.c ****       step = 1;  // Move to the next step
 955:Core/Src/main.c ****   } else if (step == 1) {
 956:Core/Src/main.c ****       // Set Joint 2 and start a delay
 957:Core/Src/main.c ****       joint2 = JOINT2_HOME;
 958:Core/Src/main.c ****       Joint2Set(joint2);
 959:Core/Src/main.c ****       joint5 = JOINT5_HOME;
 960:Core/Src/main.c ****       Joint5Set(joint5);
 961:Core/Src/main.c ****       lastMillis = HAL_GetTick();  // Start the 1-second delay
 962:Core/Src/main.c ****       step = 2;  // Move to the next step
 963:Core/Src/main.c ****   } else if (step == 2) {
 964:Core/Src/main.c ****       // Wait for 1 second before proceeding
 965:Core/Src/main.c ****       if (HAL_GetTick() - lastMillis >= 1000) {
 966:Core/Src/main.c ****           // Once 1 second has passed, set the remaining joints
 967:Core/Src/main.c ****           joint3 = JOINT3_HOME;
 968:Core/Src/main.c ****           Joint3Set(joint3);
 969:Core/Src/main.c ****           joint4 = JOINT4_HOME;
 970:Core/Src/main.c ****           Joint4Set(joint4);
 971:Core/Src/main.c ****           
 972:Core/Src/main.c ****           injectFlag = RETRACT;  // Set the inject flag
 973:Core/Src/main.c **** 
 974:Core/Src/main.c ****           step = 0;  // Reset for the next time HomeSetUser() is called
 975:Core/Src/main.c ****       }
 976:Core/Src/main.c ****   }
 977:Core/Src/main.c **** }
