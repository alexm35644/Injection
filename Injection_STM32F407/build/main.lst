 967:Core/Src/main.c **** void HomeSetUser() {
 968:Core/Src/main.c ****   static uint32_t lastMillis = 0;
 969:Core/Src/main.c ****   static uint8_t step = 0;  // To track which part of the process we are at.
 970:Core/Src/main.c **** 
 971:Core/Src/main.c ****   if (step == 0) {
 972:Core/Src/main.c ****       // Set Joint 1
 973:Core/Src/main.c ****       joint1 = JOINT1_HOME;
 974:Core/Src/main.c ****       Joint1Set(joint1);
 975:Core/Src/main.c ****       step = 1;  // Move to the next step
 976:Core/Src/main.c ****   } else if (step == 1) {
 977:Core/Src/main.c ****       // Set Joint 2 and start a delay
 978:Core/Src/main.c ****       joint2 = JOINT2_HOME;
 979:Core/Src/main.c ****       Joint2Set(joint2);
 980:Core/Src/main.c ****       joint5 = JOINT5_HOME;
 981:Core/Src/main.c ****       Joint5Set(joint5);
 982:Core/Src/main.c ****       lastMillis = HAL_GetTick();  // Start the 1-second delay
 983:Core/Src/main.c ****       step = 2;  // Move to the next step
 984:Core/Src/main.c ****   } else if (step == 2) {
 985:Core/Src/main.c ****       // Wait for 1 second before proceeding
 986:Core/Src/main.c ****       if (HAL_GetTick() - lastMillis >= 1000) {
 987:Core/Src/main.c ****           // Once 1 second has passed, set the remaining joints
 988:Core/Src/main.c ****           joint3 = JOINT3_HOME;
 989:Core/Src/main.c ****           Joint3Set(joint3);
 990:Core/Src/main.c ****           joint4 = JOINT4_HOME;
ARM GAS  /var/folders/8x/_y6g3dfs0698dfd49y4vcg_w0000gn/T//cciIlfrw.s 			page 24


 991:Core/Src/main.c ****           Joint4Set(joint4);
 992:Core/Src/main.c ****           
 993:Core/Src/main.c ****           injectFlag = RETRACT;  // Set the inject flag
 994:Core/Src/main.c **** 
 995:Core/Src/main.c ****           step = 0;  // Reset for the next time HomeSetUser() is called
 996:Core/Src/main.c ****       }
 997:Core/Src/main.c ****   }
 998:Core/Src/main.c **** }
